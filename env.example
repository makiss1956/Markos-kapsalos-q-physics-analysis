# ── Quantum Lottery Analysis V2 — μυστικά ρυθμίσεις ─────────────────────
# Αντίγραψε αυτό το αρχείο σε ".env" και συμπλήρωσε τα δικά σου στοιχεία.
# ΣΗΜΑΝΤΙΚΟ: Το .env ΔΕΝ ανεβαίνει ποτέ στο GitHub (είναι στο .gitignore).

# Ο Gmail λογαριασμός αποστολέα
GMAIL_USER=το_email_σου@gmail.com

# App Password 16 χαρακτήρων (ΟΧΙ ο κύριος κωδικός!)
# Δημιουργία: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Πού θα φτάνουν οι προβλέψεις
EMAIL_TO=το_email_σου@gmail.com

# (προαιρετικά) απενεργοποίηση email: EMAIL_ENABLED=false
